`timescale 1ns / 1ps

module board_top (
    input        clk,
    input  [2:0] sw,       // SW2..SW0 = program select
    output [7:0] led,
    output       led_hlt, led_in,
    output [7:0] AN,       // digit enables, active low
    output [7:0] seg,      // segments a..g + dp, active low
    output reg flag_zero,flag_carry,rst,prog,start
);

    wire       slow_pulse;
    wire [3:0] prog_addr;
    wire [7:0] prog_data;
    wire [7:0] input_data;

    // 0 custom, 1 fib, 2 ADD, 3 SUB, 4 AND, 5 XOR, 6 MUL, 7 DIV
    wire [2:0] prog_sel = sw;

    wire [7:0] output_data;
    wire       hlt;

    clk_div DIV (
        .clk_in(clk),
        .clk_out(slow_pulse)
    );

    vio_0 VIO (
        .clk(clk),
        .probe_out0(prog_addr),
        .probe_out1(prog_data),
        .probe_out2(input_data)
    );

    cpu_top CPU (
        .clk(slow_pulse),
        .rst(rst),
        .start(start),
        .prog(prog),
        .prog_sel(prog_sel),
        .prog_addr(prog_addr),
        .prog_data(prog_data),
        .input_data(input_data),
        .output_data(output_data),
        .hlt(hlt),
        .led_in(led_in),
        .pc_value(),
        .instr_value()
    );

    assign led     = output_data;
    assign led_hlt = hlt;

    output_display DISP (
        .clk(clk),
        .value(output_data),
        .AN(AN),
        .seg(seg)
    );

endmodule
